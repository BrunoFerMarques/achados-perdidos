# Copie para .env (nesta pasta) e preencha. Nunca commite o .env.

# Banco usado pela API. Local: branch "dev" do Neon. Produção: configurado no Render.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Banco usado pelo pytest. Nunca aponte para produção: os testes criam tabelas e gravam dados.
TEST_DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Chave que assina os tokens de login (JWT). Local: gere uma com o comando abaixo. Produção: configurada no Render.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais
